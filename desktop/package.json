{
  "name": "new-feed-erp-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "NEW FEED ERP Windows employee client",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.newfeed.erp.desktop",
    "productName": "NEW FEED ERP",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "config.cjs",
      "setup.html",
      "setup.js"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "engomar1611-sys",
        "repo": "Omar",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "NEW-FEED-ERP-Employee-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "NEW FEED ERP"
    }
  }
}
