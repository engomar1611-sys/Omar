# Local network profile: create a DNS record (or hosts-file entry) for erp.lan
# pointing to the Windows server LAN IP. Caddy creates an internal TLS certificate.
erp.lan {
    tls internal
    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "SAMEORIGIN"
        -Server
    }

    reverse_proxy 127.0.0.1:3000
}

# For public internet access later, replace erp.lan with a domain you own,
# remove "tls internal", point public DNS to this server, and allow TCP 80/443.
